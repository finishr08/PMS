generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  printJobs PrintJob[]
}

model KioskSession {
  id        String             @id @default(uuid())
  tokenHash String             @unique
  status    KioskSessionStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime
  endedAt   DateTime?

  files   UploadedFile[]
  batches PrintBatch[]

  @@index([status, expiresAt])
}

model UploadedFile {
  id        String @id @default(uuid())
  sessionId String

  originalName  String
  mimeType      String
  sizeBytes     BigInt
  receivedBytes BigInt @default(0)
  storageKey    String @unique

  status     UploadStatus @default(PENDING)
  totalPages Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  expiresAt   DateTime
  deletedAt   DateTime?

  session KioskSession @relation(fields: [sessionId], references: [id])

  printJobs PrintJob[]

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model PrintBatch {
  id        String @id @default(uuid())
  sessionId String

  status PrintBatchStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  session KioskSession @relation(fields: [sessionId], references: [id])

  jobs PrintJob[]

  @@index([sessionId, createdAt])
  @@index([status])
}

model PrintJob {
  id     String @id @default(cuid())
  userId String

  filename   String
  copies     Int            @default(1)
  pageRange  String         @default("all")
  paperSize  String         @default("A4")
  totalPages Int
  status     PrintJobStatus @default(QUEUED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id])
  batchId        String?
  uploadedFileId String?

  batch PrintBatch? @relation(fields: [batchId], references: [id])

  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([batchId])
  @@index([uploadedFileId])
}

enum PrintJobStatus {
  QUEUED
  PROCESSING
  SUBMITTED
  COMPLETED
  FAILED
}

enum KioskSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum UploadStatus {
  PENDING
  UPLOADING
  READY
  FAILED
  DELETING
  DELETED
}

enum PrintBatchStatus {
  DRAFT
  QUEUED
  PROCESSING
  SUBMITTED
  COMPLETED
  FAILED
  PARTIAL
}
